WORKER_API_URL=http://localhost:3001
WORKER_NAME=worker-local-1
WORKER_CLOUD=aws
WORKER_REGION=us-east-1
WORKER_INSTANCE_ID=local-dev
WORKER_POLL_INTERVAL_MS=5000
WORKER_ROOT_DIR=.worker-runs
WORKER_PUBLIC_HOST=
WORKER_PUBLIC_SCHEME=http
WORKER_PUBLIC_BASE_PATH=/deployments
WORKER_PROXY_PROVIDER=none
WORKER_NGINX_CONFIG_DIR=/etc/nginx/conf.d/clircel
WORKER_NGINX_VALIDATE_COMMAND=nginx -t
WORKER_NGINX_RELOAD_COMMAND=systemctl reload nginx
